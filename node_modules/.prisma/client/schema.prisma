datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// តារាង User សម្រាប់បុគ្គលិក Login
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// តារាងព័ត៌មានអ្នកជំងឺ
model Patient {
  id        Int      @id @default(autoincrement())
  name      String
  gender    String
  age       Int
  phone     String   @unique
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patients")
}

enum Role {
  SUPER_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  CASHIER
}
